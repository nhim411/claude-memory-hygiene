{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-health.sh\"", "timeout": 15 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Bash|Grep", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-py.sh\" memory-usage.py", "timeout": 5 } ] }
    ]
  }
}
